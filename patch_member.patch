+/**
+ * Sync the community directory and follow lists from the backend
+ */
+export async function syncCommunityWithBackend() {
+  const user = auth.currentUser;
+  if (!user) return;
+  try {
+    const members = await backendApiCall('getCommunity', { uid: user.uid });
+    if (members) {
+      localStorage.setItem(COMMUNITY_MEMBERS_KEY, JSON.stringify(members));
+    }
+  } catch (err) {
+    console.warn("Failed to sync community", err);
+  }
+}
