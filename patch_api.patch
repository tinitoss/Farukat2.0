+export const syncXpAccountWithBackend = async () => {
+  const user = auth.currentUser;
+  if (!user) return getXpAccount();
+  
+  try {
+    const data = await backendApiCall('getUserData', { 
+      uid: user.uid, 
+      email: user.email, 
+      name: user.displayName, 
+      photoURL: user.photoURL 
+    });
+    
+    if (data) {
+      const local = getXpAccount();
+      local.currentLevel = data.level;
+      local.currentXp = data.currentXp;
+      local.lifetimeXp = data.lifetimeXp;
+      local.profile.tier = data.membershipTier;
+      local.profile.cardNumber = data.cardNumber;
+      local.profile.memberId = data.memberId;
+      local.profile.signatureUrl = data.signatureUrl;
+      // Save to local cache
+      saveXpAccount(local);
+      return local;
+    }
+  } catch (err) {
+    console.error('Failed to sync XP Account with backend', err);
+  }
+  return getXpAccount();
+};
